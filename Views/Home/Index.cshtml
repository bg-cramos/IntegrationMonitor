@model IntegrationMonitor.Models.IntegrationStatus
@{
    ViewBag.Title = "NATS INTEGRACION";
}
<div class="monitor-container">
    <!-- HEADER -->
    <div class="monitor-header">
        <div class="header-title">
            <div class="header-icon">
                N
            </div>
            <div>
                <h1>NATS INTEGRACION</h1>
                <p>
                    Monitor del servidor y conexiones NATS
                </p>
            </div>
        </div>
        <div class="last-update">
            <span>
                Última actualización
            </span>
            <strong id="ultimaActualizacion">
                @Model.UltimaActualizacion.ToString("HH:mm:ss")
            </strong>
        </div>
    </div>

    <!-- RESUMEN -->
    <div class="summary-grid">
        <!-- SERVIDOR -->
        <div class="summary-card">
            <div class="summary-label">
                SERVIDOR
            </div>
            <div class="summary-value">
                @Model.NatsServer
            </div>
            <div class="summary-status" id="natsEstado">
                @if (Model.NatsConnected)
                {
                    <span class="status-dot status-green"></span>
                    <span class="status-text green">
                        CONNECTED
                    </span>
                }
                else
                {
                    <span class="status-dot status-red"></span>
                    <span class="status-text red">
                        DISCONNECTED
                    </span>
                }
            </div>
        </div>

        <!-- SUBJECTS -->
        <div class="summary-card">
            <div class="summary-label">
                SUBJECTS ACTIVOS
            </div>
            <div id="cantidadSubjects"
                 class="summary-number blue">
                @(Model.Subjects == null ? 0 : Model.Subjects.Count)
            </div>
            <div class="summary-description">
                Subjects detectados
            </div>
        </div>

        <!-- CONEXIONES -->
        <div class="summary-card">
            <div class="summary-label">
                CONEXIONES NATS
            </div>
            <div id="cantidadConexiones"
                 class="summary-number blue">
                @(Model.NatsConnections == null ? 0 : Model.NatsConnections.Count)
            </div>
            <div class="summary-description">
                Clientes conectados
            </div>
        </div>

        <!-- ERRORES -->
        <div class="summary-card">
            <div class="summary-label">
                ERRORES
            </div>
            <div id="errores"
                 class="summary-number red">
                @Model.Errores
            </div>
            <div class="summary-description">
                Errores registrados
            </div>
        </div>
    </div>

    <!-- SUBJECTS -->
    <div class="monitor-panel">
        <div class="panel-header">
            <div>
                <span class="panel-icon">
                    📡
                </span>
                <strong>
                    SUBJECTS NATS
                </strong>
            </div>
            <span class="panel-counter"
                  id="subjectsResumen">
                @(Model.Subjects == null ? 0 : Model.Subjects.Count)
                @(
                                    Model.Subjects == null ||
                                    Model.Subjects.Count != 1
                                        ? "subjects"
                                        : "subject"
                )
            </span>
        </div>

        <div id="subjectsContainer"
             class="panel-content">
            @if (
                Model.Subjects == null ||
                Model.Subjects.Count == 0
            )
            {
                <div class="empty-state">
                    <span class="status-dot status-yellow"></span>
                    No hay subjects activos

                </div>
            }
            else
            {
                foreach (var subject in Model.Subjects)
                {
                    <div class="subject-card">
                        <div class="subject-header">
                            <div class="subject-name">
                                <span class="subject-icon">
                                    📡
                                </span>
                                <strong>
                                    @subject.Subject
                                </strong>
                            </div>
                            <div class="subject-connections">
                                <span class="status-dot status-green"></span>
                                @subject.Connections
                                @(
                                                    subject.Connections == 1
                                                        ? "conexión"
                                                        : "conexiones"
                                )
                            </div>
                        </div>

                        <div class="subject-clients">
                            @if (subject.Clients != null)
                            {
                                foreach (var client in subject.Clients)
                                {


                                    <div class="client-row">
                                        <div class="client-main">
                                            <span class="status-dot status-green"></span>
                                            <a href="@Url.Action(
                                                "Logs",
                                                "Home",
                                                new
                                                {
                                                    cid = client.Cid,
                                                    subject = subject.Subject
                                                })"
                                               class="cid-link">

                                                Cid @client.Cid
                                            </a>


                                            @if (!string.IsNullOrWhiteSpace(client.Lang))
                                            {
                                                <span class="client-lang">
                                                    @client.Lang
                                                </span>
                                            }
                                        </div>

                                        <div class="client-details">
                                            <div>
                                                <span class="detail-label">
                                                    IP
                                                </span>
                                                <span>
                                                    @client.Ip
                                                </span>
                                            </div>
                                            <div>
                                                <span class="detail-label">
                                                    PUERTO
                                                </span>
                                                <span>
                                                    @client.Port
                                                </span>
                                            </div>
                                            <div>
                                                <span class="detail-label">
                                                    VERSIÓN
                                                </span>
                                                <span>
                                                    @client.Version
                                                </span>
                                            </div>
                                            <div>
                                                <span class="detail-label">
                                                    UPTIME
                                                </span>
                                                <span>
                                                    @client.Uptime
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- CONEXIONES -->
    <div class="monitor-panel">
        <div class="panel-header">
            <div>
                <span class="panel-icon">
                    🔌
                </span>
                <strong>
                    CONEXIONES NATS
                </strong>
            </div>
            <span class="panel-counter"
                  id="cantidadConexionesHeader">
                @(Model.NatsConnections == null
                                    ? 0
                                    : Model.NatsConnections.Count)
            </span>
        </div>

        <div id="conexionesContainer"
             class="panel-content">
            @if (
                Model.NatsConnections == null ||
                Model.NatsConnections.Count == 0
            )
            {
                <div class="empty-state">
                    <span class="status-dot status-yellow"></span>
                    No hay conexiones NATS

                </div>
            }
            else
            {
                foreach (var connection in Model.NatsConnections)
                {
                    <div class="connection-card">
                        <div class="connection-title">
                            <div class="connection-client">
                                <span class="status-dot status-green"></span>
                                <strong>
                                    Cid @connection.Cid
                                </strong>
                            </div>
                            <span class="client-lang">
                                @(
                                                    string.IsNullOrWhiteSpace(connection.Lang)
                                                        ? "N/A"
                                                        : connection.Lang
                                )
                            </span>
                        </div>

                        <div class="connection-info">
                            <div>
                                <span class="detail-label">
                                    IP
                                </span>
                                <strong>
                                    @connection.Ip
                                </strong>
                            </div>
                            <div>
                                <span class="detail-label">
                                    PUERTO
                                </span>
                                <strong>
                                    @connection.Port
                                </strong>
                            </div>
                            <div>
                                <span class="detail-label">
                                    VERSIÓN
                                </span>
                                <strong>
                                    @connection.Version
                                </strong>
                            </div>
                            <div>
                                <span class="detail-label">
                                    UPTIME
                                </span>
                                <strong>
                                    @connection.Uptime
                                </strong>
                            </div>
                        </div>

                        <div class="connection-subjects">
                            <span class="detail-label">
                                ESCUCHANDO
                            </span>
                            <div class="subject-tags">
                                @if (
                                    connection.SubscriptionsList != null &&
                                    connection.SubscriptionsList.Count > 0
                                )
                                {
                                    foreach (
                                        var sub
                                        in connection.SubscriptionsList
                                    )
                                    {
                                        <span class="subject-tag">
                                            @sub
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="no-subjects">
                                        Sin subjects
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

  
