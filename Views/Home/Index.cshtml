    <script>

    // =========================================
    // CONVERTIR FECHA ASP.NET MVC
    // =========================================

    function convertirFechaMvc(valor) {

        if (!valor) {
            return null;
        }

        // Formato ASP.NET MVC:
        // /Date(1790775981471)/

        if (typeof valor === 'string') {

            var match =
                valor.match(/\/Date\((\d+)\)\//);

            if (match) {

                return new Date(
                    parseInt(match[1], 10)
                );

            }

            // Intentar fecha normal
            var fechaNormal =
                new Date(valor);

            if (!isNaN(fechaNormal.getTime())) {
                return fechaNormal;
            }
        }

        // Por si ya viene como Date/timestamp
        var fecha =
            new Date(valor);

        if (!isNaN(fecha.getTime())) {
            return fecha;
        }

        return null;
    }


    // =========================================
    // FORMATEAR HORA
    // =========================================

    function formatearHora(valor) {

        var fecha =
            convertirFechaMvc(valor);

        if (!fecha) {
            return '--';
        }

        return fecha.toLocaleTimeString(
            'es-AR',
            {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            }
        );
    }


    // =========================================
    // FORMATEAR FECHA Y HORA
    // =========================================

    function formatearFechaHora(valor) {

        var fecha =
            convertirFechaMvc(valor);

        if (!fecha) {
            return '--';
        }

        return fecha.toLocaleString(
            'es-AR',
            {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            }
        );
    }


    // =========================================
    // ACTUALIZAR MONITOR
    // =========================================

    function actualizarMonitor() {

        $.ajax({

            url:
                '@Url.Action("Estado", "Home")',

            type:
                'GET',

            cache:
                false,


            success:
                function (data) {


                    // =========================================
                    // ÚLTIMA ACTUALIZACIÓN
                    // =========================================

                    $('#ultimaActualizacion')
                        .text(
                            formatearHora(
                                data.UltimaActualizacion
                            )
                        );


                    // =========================================
                    // ESTADO NATS
                    // =========================================

                    if (
                        data.NatsConnected
                    ) {

                        $('#natsEstado').html(

                            '<span class="status-dot status-green"></span>' +

                            '<span class="status-text green">' +
                            'CONNECTED' +
                            '</span>'

                        );

                    }
                    else {

                        $('#natsEstado').html(

                            '<span class="status-dot status-red"></span>' +

                            '<span class="status-text red">' +
                            'DISCONNECTED' +
                            '</span>'

                        );

                    }


                    // =========================================
                    // SUBJECTS
                    // =========================================

                    var subjects =
                        data.Subjects || [];


                    $('#cantidadSubjects')
                        .text(
                            subjects.length
                        );


                    $('#subjectsResumen')
                        .text(

                            subjects.length +

                            (
                                subjects.length === 1
                                    ? ' subject'
                                    : ' subjects'
                            )

                        );


                    var subjectsHtml =
                        '';


                    if (
                        subjects.length === 0
                    ) {

                        subjectsHtml =

                            '<div class="empty-state">' +

                            '<span class="status-dot status-yellow"></span>' +

                            'No hay subjects activos' +

                            '</div>';

                    }
                    else {

                        $.each(

                            subjects,

                            function (
                                index,
                                subject
                            ) {

                                subjectsHtml +=

                                    '<div class="subject-card">';


                                // =================================
                                // HEADER SUBJECT
                                // =================================

                                subjectsHtml +=

                                    '<div class="subject-header">';


                                subjectsHtml +=

                                    '<div class="subject-name">' +

                                    '<span class="subject-icon">📡</span>' +

                                    '<strong>' +

                                    escapeHtml(
                                        subject.Subject
                                    ) +

                                    '</strong>' +

                                    '</div>';


                                subjectsHtml +=

                                    '<div class="subject-connections">' +

                                    '<span class="status-dot status-green"></span>' +

                                    escapeHtml(
                                        subject.Connections
                                    ) +

                                    (
                                        subject.Connections === 1
                                            ? ' conexión'
                                            : ' conexiones'
                                    ) +

                                    '</div>';


                                subjectsHtml +=
                                    '</div>';


                                // =================================
                                // CLIENTES
                                // =================================

                                subjectsHtml +=

                                    '<div class="subject-clients">';


                                var clients =
                                    subject.Clients || [];


                                $.each(

                                    clients,

                                    function (
                                        i,
                                        client
                                    ) {


                                        var logsUrl =

                                            '@Url.Action(
                                                "Logs",
                                                "Home"
                                            )' +

                                            '?cid=' +

                                            encodeURIComponent(
                                                client.Cid
                                            ) +

                                            '&subject=' +

                                            encodeURIComponent(
                                                subject.Subject
                                            );


                                        subjectsHtml +=

                                            '<div class="client-row">';


                                        subjectsHtml +=

                                            '<div class="client-main">' +

                                            '<span class="status-dot status-green"></span>' +

                                            '<a href="' +
                                            logsUrl +
                                            '" class="cid-link">' +

                                            'Cid ' +

                                            escapeHtml(
                                                client.Cid
                                            ) +

                                            '</a>';


                                        if (

                                            client.Lang &&

                                            client.Lang
                                                .toString()
                                                .trim() !== ''

                                        ) {

                                            subjectsHtml +=

                                                '<span class="client-lang">' +

                                                escapeHtml(
                                                    client.Lang
                                                ) +

                                                '</span>';

                                        }


                                        subjectsHtml +=
                                            '</div>';


                                        subjectsHtml +=

                                            '<div class="client-details">';


                                        subjectsHtml +=

                                            '<div>' +

                                            '<span class="detail-label">' +
                                            'IP' +
                                            '</span>' +

                                            '<span>' +

                                            escapeHtml(
                                                client.Ip
                                            ) +

                                            '</span>' +

                                            '</div>';


                                        subjectsHtml +=

                                            '<div>' +

                                            '<span class="detail-label">' +
                                            'PUERTO' +
                                            '</span>' +

                                            '<span>' +

                                            escapeHtml(
                                                client.Port
                                            ) +

                                            '</span>' +

                                            '</div>';


                                        subjectsHtml +=

                                            '<div>' +

                                            '<span class="detail-label">' +
                                            'VERSIÓN' +
                                            '</span>' +

                                            '<span>' +

                                            escapeHtml(
                                                client.Version
                                            ) +

                                            '</span>' +

                                            '</div>';


                                        subjectsHtml +=

                                            '<div>' +

                                            '<span class="detail-label">' +
                                            'UPTIME' +
                                            '</span>' +

                                            '<span>' +

                                            escapeHtml(
                                                client.Uptime
                                            ) +

                                            '</span>' +

                                            '</div>';


                                        subjectsHtml +=
                                            '</div>';


                                        subjectsHtml +=
                                            '</div>';

                                    }

                                );


                                subjectsHtml +=

                                    '</div>' +
                                    '</div>';

                            }

                        );

                    }


                    $('#subjectsContainer')
                        .html(
                            subjectsHtml
                        );


                    // =========================================
                    // CONEXIONES
                    // =========================================

                    var connections =
                        data.NatsConnections || [];


                    $('#cantidadConexiones')
                        .text(
                            connections.length
                        );


                    $('#cantidadConexionesHeader')
                        .text(
                            connections.length
                        );


                    var connectionsHtml =
                        '';


                    if (
                        connections.length === 0
                    ) {

                        connectionsHtml =

                            '<div class="empty-state">' +

                            '<span class="status-dot status-yellow"></span>' +

                            'No hay conexiones NATS' +

                            '</div>';

                    }
                    else {

                        $.each(

                            connections,

                            function (
                                index,
                                connection
                            ) {


                                connectionsHtml +=

                                    '<div class="connection-card">';


                                // =================================
                                // TITULO
                                // =================================

                                connectionsHtml +=

                                    '<div class="connection-title">';


                                connectionsHtml +=

                                    '<div class="connection-client">' +

                                    '<span class="status-dot status-green"></span>' +

                                    '<strong>' +

                                    'Cid ' +

                                    escapeHtml(
                                        connection.Cid
                                    ) +

                                    '</strong>' +

                                    '</div>';


                                connectionsHtml +=

                                    '<span class="client-lang">' +

                                    escapeHtml(
                                        connection.Lang || 'N/A'
                                    ) +

                                    '</span>';


                                connectionsHtml +=
                                    '</div>';


                                // =================================
                                // INFORMACION
                                // =================================

                                connectionsHtml +=

                                    '<div class="connection-info">';


                                connectionsHtml +=

                                    '<div>' +

                                    '<span class="detail-label">' +
                                    'IP' +
                                    '</span>' +

                                    '<strong>' +

                                    escapeHtml(
                                        connection.Ip
                                    ) +

                                    '</strong>' +

                                    '</div>';


                                connectionsHtml +=

                                    '<div>' +

                                    '<span class="detail-label">' +
                                    'PUERTO' +
                                    '</span>' +

                                    '<strong>' +

                                    escapeHtml(
                                        connection.Port
                                    ) +

                                    '</strong>' +

                                    '</div>';


                                connectionsHtml +=

                                    '<div>' +

                                    '<span class="detail-label">' +
                                    'VERSIÓN' +
                                    '</span>' +

                                    '<strong>' +

                                    escapeHtml(
                                        connection.Version || 'N/A'
                                    ) +

                                    '</strong>' +

                                    '</div>';


                                connectionsHtml +=

                                    '<div>' +

                                    '<span class="detail-label">' +
                                    'UPTIME' +
                                    '</span>' +

                                    '<strong>' +

                                    escapeHtml(
                                        connection.Uptime || 'N/A'
                                    ) +

                                    '</strong>' +

                                    '</div>';


                                connectionsHtml +=
                                    '</div>';


                                // =================================
                                // SUBJECTS
                                // =================================

                                connectionsHtml +=

                                    '<div class="connection-subjects">' +

                                    '<span class="detail-label">' +

                                    'ESCUCHANDO' +

                                    '</span>' +

                                    '<div class="subject-tags">';


                                var subs =
                                    connection.SubscriptionsList || [];


                                if (
                                    subs.length === 0
                                ) {

                                    connectionsHtml +=

                                        '<span class="no-subjects">' +

                                        'Sin subjects' +

                                        '</span>';

                                }
                                else {

                                    $.each(

                                        subs,

                                        function (
                                            i,
                                            sub
                                        ) {

                                            connectionsHtml +=

                                                '<span class="subject-tag">' +

                                                escapeHtml(
                                                    sub
                                                ) +

                                                '</span>';

                                        }

                                    );

                                }


                                connectionsHtml +=

                                    '</div>' +
                                    '</div>' +
                                    '</div>';

                            }

                        );

                    }


                    $('#conexionesContainer')
                        .html(
                            connectionsHtml
                        );


                },


            error:
                function () {

                    $('#natsEstado').html(

                        '<span class="status-dot status-red"></span>' +

                        '<span class="status-text red">' +

                        'ERROR MONITOR' +

                        '</span>'

                    );

                }

        });

    }


    // =========================================
    // ESCAPAR HTML
    // =========================================

    function escapeHtml(value) {

        if (
            value === null ||
            value === undefined
        ) {

            return '';

        }


        return $('<div>')
            .text(value)
            .html();

    }


    // =========================================
    // INICIO
    // =========================================

    $(document).ready(

        function () {

            actualizarMonitor();


            setInterval(

                actualizarMonitor,

                5000

            );

        }

    );

    </script>

