@model IntegrationMonitor.Models.LogViewModel

@using System.Web

@{
    ViewBag.Title = "NATS MESSAGE";

    string subject =
        (Model.Subject ?? "").Trim();
}

<div class="message-container">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="message-header">

        <div>

            <h1>
                NATS MESSAGE MONITOR
            </h1>

            <p>

                CID:
                <strong>
                    @Model.Cid
                </strong>

                <span class="separator">|</span>

                Subject:
                <strong>
                    @Model.Subject
                </strong>

            </p>

        </div>

        <div class="connection-status">

            <span id="connectionIndicator"
                  class="status-dot disconnected">
            </span>

            <span id="connectionText">
                DESCONECTADO
            </span>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- INFORMACION -->
    <!-- ================================================= -->

    <div class="message-info">

        <div>

            <span class="info-label">
                ESTADO
            </span>

            <span id="messageStatus"
                  class="info-value">
                Esperando mensajes...
            </span>

        </div>

        <div>

            <span class="info-label">
                ÚLTIMO MENSAJE
            </span>

            <span id="lastMessage"
                  class="info-value">
                -
            </span>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- VISOR JSON -->
    <!-- ================================================= -->

    <div id="messageViewer"
         class="message-viewer">

        <div class="empty-message">

            Esperando mensaje NATS...

        </div>

    </div>

</div>


<style>

    /* ============================================= */
    /* CONTENEDOR */
    /* ============================================= */

    .message-container {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 20px 15px 30px;
    }


    /* ============================================= */
    /* HEADER */
    /* ============================================= */

    .message-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #050505;
        color: #ffffff;
        padding: 20px 25px;
        border: 1px solid #2a2a2a;
        border-bottom: none;
        border-radius: 8px 8px 0 0;
        font-family: Consolas, "Courier New", monospace;
    }


        .message-header h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
            color: #ffffff;
        }


        .message-header p {
            margin: 7px 0 0;
            color: #bdbdbd;
            font-size: 13px;
        }


        .message-header strong {
            color: #ffffff;
        }


    .separator {
        margin: 0 8px;
        color: #666666;
    }


    /* ============================================= */
    /* ESTADO CONEXION */
    /* ============================================= */

    .connection-status {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: Consolas, "Courier New", monospace;
        font-size: 12px;
        font-weight: bold;
        color: #ffffff;
    }


    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }


        .status-dot.connected {
            background: #22c55e;
            box-shadow: 0 0 5px #22c55e, 0 0 10px #22c55e;
        }


        .status-dot.disconnected {
            background: #ef4444;
            box-shadow: 0 0 5px #ef4444, 0 0 10px #ef4444;
        }


    /* ============================================= */
    /* INFORMACION */
    /* ============================================= */

    .message-info {
        display: flex;
        gap: 40px;
        background: #0a0a0a;
        color: #ffffff;
        padding: 12px 20px;
        border-left: 1px solid #2a2a2a;
        border-right: 1px solid #2a2a2a;
        border-bottom: 1px solid #2a2a2a;
        font-family: Consolas, "Courier New", monospace;
    }


    .info-label {
        color: #777777;
        font-size: 10px;
        font-weight: bold;
        margin-right: 8px;
    }


    .info-value {
        color: #ffffff;
        font-size: 12px;
    }


    /* ============================================= */
    /* VISOR ESTILO CMD */
    /* ============================================= */

    .message-viewer {
        background: #000000;
        color: #ffffff;
        height: 650px;
        padding: 20px;
        font-family: Consolas, "Courier New", monospace;
        font-size: 14px;
        line-height: 1.6;
        border-left: 1px solid #2a2a2a;
        border-right: 1px solid #2a2a2a;
        border-bottom: 1px solid #2a2a2a;
        border-radius: 0 0 8px 8px;
        overflow: auto;
        box-sizing: border-box;
    }


    /* ============================================= */
    /* JSON */
    /* ============================================= */

    .json-message {
        margin: 0;
        padding: 0;
        white-space: pre-wrap;
        word-break: break-word;
        color: #ffffff;
        background: transparent;
        font-family: Consolas, "Courier New", monospace;
        font-size: 14px;
        line-height: 1.6;
    }


    /* ============================================= */
    /* MENSAJE VACIO */
    /* ============================================= */

    .empty-message {
        color: #777777;
        text-align: center;
        padding-top: 250px;
        font-family: Consolas, "Courier New", monospace;
        font-size: 14px;
    }


    /* ============================================= */
    /* NUEVO MENSAJE */
    /* ============================================= */

    .message-received {
        color: #ffffff;
    }


    /* ============================================= */
    /* SCROLLBAR */
    /* ============================================= */

    .message-viewer::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }


    .message-viewer::-webkit-scrollbar-track {
        background: #080808;
    }


    .message-viewer::-webkit-scrollbar-thumb {
        background: #444444;
        border-radius: 5px;
    }


        .message-viewer::-webkit-scrollbar-thumb:hover {
            background: #666666;
        }


    /* ============================================= */
    /* RESPONSIVE */
    /* ============================================= */

    @@media (max-width: 700px) {

        .message-container {
            padding: 10px 5px 20px;
        }


        .message-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }


        .message-info {
            flex-direction: column;
            gap: 8px;
        }


        .message-viewer {
            height: 500px;
            font-size: 12px;
        }


        .json-message {
            font-size: 12px;
        }
    }
</style>


<script>

    $(document).ready(function () {

        var cid =
            @Model.Cid;


        var subject =
            '@Html.Raw(
                HttpUtility.JavaScriptStringEncode(
                    subject
                )
            )';


        console.log(
            'Monitor NATS iniciado:',
            {
                cid: cid,
                subject: subject
            }
        );


        /*
         * =====================================================
         * MOSTRAR MENSAJE
         * =====================================================
         */

        function mostrarMensaje(
            mensaje
        ) {

            if (
                mensaje === null
                ||
                mensaje === undefined
            ) {
                return;
            }


            var texto =
                String(
                    mensaje
                );


            /*
             * Intentamos formatear JSON solamente
             * para visualizarlo.
             *
             * NO modificamos el mensaje original.
             */

            var contenido =
                texto;


            try {

                var json =
                    JSON.parse(
                        texto
                    );


                contenido =
                    JSON.stringify(
                        json,
                        null,
                        2
                    );

            }
            catch (e) {

                /*
                 * Si no es JSON válido,
                 * mostramos exactamente
                 * lo recibido.
                 */

                contenido =
                    texto;
            }


            $('#messageViewer').prepend(

                $('<pre>')
                    .addClass(
                        'json-message message-received'
                    )
                    .text(
                        contenido
                    )

            );


            $('#messageStatus')
                .text(
                    'Mensaje recibido'
                );


            $('#lastMessage')
                .text(
                    new Date()
                        .toLocaleTimeString()
                );

        }


        /*
         * =====================================================
         * POLLING
         *
         * Consultamos al servidor cada segundo.
         * =====================================================
         */

        var ultimoMensajeId =
            0;


        function consultarMensaje() {

            $.ajax({

                url:
                    '@Url.Action(
                        "MensajeNats",
                        "Home"
                    )',

                type:
                    'GET',

                data:
                {
                    cid:
                        cid,

                    subject:
                        subject,

                    ultimoMensajeId:
                        ultimoMensajeId
                },

                success:
                    function (respuesta) {

                        /*
                         * =====================================
                         * ESTADO DE CONEXION
                         * =====================================
                         */

                        if (
                            respuesta
                            &&
                            respuesta.conectado
                        ) {

                            $('#connectionIndicator')
                                .removeClass(
                                    'disconnected'
                                )
                                .addClass(
                                    'connected'
                                );


                            $('#connectionText')
                                .text(
                                    'CONECTADO'
                                );

                        }
                        else {

                            $('#connectionIndicator')
                                .removeClass(
                                    'connected'
                                )
                                .addClass(
                                    'disconnected'
                                );


                            $('#connectionText')
                                .text(
                                    'DESCONECTADO'
                                );

                        }


                        /*
                         * =====================================
                         * MENSAJE NUEVO
                         * =====================================
                         */

                        if (
                            respuesta
                            &&
                            respuesta.hayMensaje
                        ) {

                            ultimoMensajeId =
                                respuesta.id;


                            mostrarMensaje(
                                respuesta.mensaje
                            );

                        }

                    },


                error:
                    function () {

                        $('#connectionIndicator')
                            .removeClass(
                                'connected'
                            )
                            .addClass(
                                'disconnected'
                            );


                        $('#connectionText')
                            .text(
                                'DESCONECTADO'
                            );

                    }

            });

        }


        /*
         * ================================================
         * CONSULTAR CADA SEGUNDO
         * ================================================
         */

        setInterval(
            consultarMensaje,
            1000
        );


        /*
         * ================================================
         * PRIMERA CONSULTA INMEDIATA
         * ================================================
         */

        consultarMensaje();

    });

</script>